{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "accelerator", "auth", "ownership"],
  "properties": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "version", "architecture"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "maxLength": 512},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "architecture": {"type": "string", "enum": ["amd64", "arm64"]}
      }
    },
    "accelerator": {
      "type": "object", "additionalProperties": false,
      "required": ["workloadSessionId", "allowVersionMismatch"],
      "properties": {
        "workloadSessionId": {"type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"},
        "allowVersionMismatch": {"type": "boolean"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["creatorVerifier"],
      "properties": {"creatorVerifier": {"type": "string", "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"}}
    },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": ["installationId"],
      "properties": {"installationId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}
    }
  }
}
