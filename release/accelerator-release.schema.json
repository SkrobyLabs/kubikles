{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SkrobyLabs/kubikles/main/release/accelerator-release.schema.json",
  "title": "Kubikles Accelerator release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "$schema", "buildVersion", "source", "compatibility", "image", "chart"],
  "properties": {
    "schemaVersion": {"const": 1},
    "$schema": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/SkrobyLabs/kubikles/[0-9a-f]{40}/release/accelerator-release\\.schema\\.json$"},
    "buildVersion": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "gitTag"],
      "properties": {
        "repository": {"const": "https://github.com/SkrobyLabs/kubikles"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "gitTag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "desktopBuildVersion", "acceleratorBuildVersion"],
      "properties": {
        "mode": {"const": "exact-build-version"},
        "desktopBuildVersion": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "acceleratorBuildVersion": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "reference", "platforms"],
      "properties": {
        "repository": {"const": "ghcr.io/skrobylabs/kubikles-accelerator"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reference": {"type": "string", "pattern": "^ghcr\\.io/skrobylabs/kubikles-accelerator@sha256:[0-9a-f]{64}$"},
        "platforms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["os", "architecture", "manifestDigest"],
              "properties": {"os": {"const": "linux"}, "architecture": {"const": "amd64"}, "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["os", "architecture", "manifestDigest"],
              "properties": {"os": {"const": "linux"}, "architecture": {"const": "arm64"}, "manifestDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
            }
          ],
          "items": false
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "reference", "version", "appVersion"],
      "properties": {
        "repository": {"const": "oci://ghcr.io/skrobylabs/helm/kubikles-accelerator"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reference": {"type": "string", "pattern": "^oci://ghcr\\.io/skrobylabs/helm/kubikles-accelerator@sha256:[0-9a-f]{64}$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "appVersion": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    }
  }
}
